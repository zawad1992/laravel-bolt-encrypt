{
    "name": "zawadulkawum/laravel-bolt-encrypt",
    "description": "A Laravel package for encrypting PHP files using Bolt encryption",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Zawad",
            "email": "zawad1992@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/console": "^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "ZawadulKawum\\LaravelBoltEncrypt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZawadulKawum\\LaravelBoltEncrypt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZawadulKawum\\LaravelBoltEncrypt\\FileEncryptorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}